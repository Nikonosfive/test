---
interface Item { label: string; href?: string }
const { items = [] } = Astro.props as { items: Item[] };
const isHome = items.length === 1 && items[0]?.label === 'ホーム';
import { sitePath } from '@/utils/paths';
---
{items.length > 0 && (
  <nav class="breadcrumbs" aria-label="パンくずリスト" data-pagefind-ignore>
    <ol>
      {!isHome && <li><a href={sitePath('/')}>ホーム</a></li>}
      {isHome ? <li aria-current="page"><span>ホーム</span></li> : items.map((item, index) => (
        <li aria-current={index === items.length - 1 ? 'page' : undefined}>
          {item.href && index !== items.length - 1
            ? <a href={sitePath(item.href)}>{item.label}</a>
            : <span>{item.label}</span>}
        </li>
      ))}
    </ol>
  </nav>
)}
